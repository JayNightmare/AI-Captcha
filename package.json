{
	"name": "ai-captcha",
	"displayName": "AI-Captcha",
	"description": "Did you program it? Lets captcha the moment...",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.107.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "gitcaptcha-sidebar",
					"title": "Git CAPTCHA",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"gitcaptcha-sidebar": [
				{
					"type": "webview",
					"id": "gitcaptcha.sidebarView",
					"name": "Commit"
				}
			]
		},
		"commands": [
			{
				"command": "gitcaptcha.commit",
				"title": "CAPTCHA Commit"
			},
			{
				"command": "gitcaptcha.refreshSidebar",
				"title": "Refresh",
				"icon": "$(refresh)"
			}
		],
		"menus": {
			"scm/sourceControl": [
				{
					"command": "gitcaptcha.commit"
				}
			],
			"view/title": [
				{
					"command": "gitcaptcha.refreshSidebar",
					"when": "view == gitcaptcha.sidebarView",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/vscode": "^1.116.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"typescript-eslint": "^8.56.1",
		"eslint": "^9.39.3",
		"typescript": "^5.9.3",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2"
	}
}
